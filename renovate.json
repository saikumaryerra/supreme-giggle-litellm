{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump LITELLM_VERSION in the Dockerfile — the single source of truth (§9.1)",
      "fileMatch": ["^docker/Dockerfile$"],
      "matchStrings": ["ARG LITELLM_VERSION=(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "ghcr.io/berriai/litellm",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["ghcr.io/berriai/litellm"],
      "groupName": "litellm base image",
      "labels": ["litellm-upgrade"],
      "schedule": ["before 9am on monday"],
      "allowedVersions": "!/latest|dev/"
    }
  ]
}
